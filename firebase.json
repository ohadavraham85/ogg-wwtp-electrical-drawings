{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "CLAUDE.md",
      "README.md",
      "docs/**",
      "legal/**",
      "firestore.rules"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|json|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
